<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="38dp"
    android:layout_marginEnd="8dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="5dp" android:paddingEnd="14dp"
    android:background="@drawable/bg_fav_chip">
    <TextView android:id="@+id/favAvatar" android:layout_width="28dp" android:layout_height="28dp"
        android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/favName" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:maxLines="1" android:ellipsize="end" android:maxWidth="130dp"
        android:textColor="@color/text" android:textSize="13sp" />
</LinearLayout>
