<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="44dp"
    android:layout_marginEnd="8dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="16dp"
    android:background="@drawable/bg_chip">
    <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
        <TextView android:id="@+id/tabAvatar" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center_vertical|start"
            android:gravity="center" android:textColor="#FFFFFF" android:textSize="14sp"
            android:textStyle="bold" />
        <ImageView android:id="@+id/tabBadge" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="bottom|end" android:padding="1.5dp"
            android:background="@drawable/bg_badge" android:scaleType="fitCenter"
            android:contentDescription="Selo do projeto" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:orientation="vertical">
        <TextView android:id="@+id/tabName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:maxWidth="140dp" android:textSize="13sp" />
        <TextView android:id="@+id/tabStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:maxLines="1" android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
