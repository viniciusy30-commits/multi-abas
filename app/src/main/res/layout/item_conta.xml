<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="44dp"
    android:layout_marginEnd="6dp" android:minWidth="64dp"
    android:paddingHorizontal="16dp" android:gravity="center"
    android:orientation="vertical" android:background="@drawable/bg_chip">
    <TextView android:id="@+id/tabName" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
        android:maxWidth="160dp" android:textSize="13sp" />
    <TextView android:id="@+id/tabStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:maxLines="1" android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
